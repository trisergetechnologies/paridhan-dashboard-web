# API base URL — include https:// in production (required at build time for best results).
# Production: https://api.paridhanemporium.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4601/api/v1

# Optional: used when NEXT_PUBLIC_API_URL is unset on admin.paridhanemporium.com
# NEXT_PUBLIC_API_ORIGIN=https://api.paridhanemporium.com
# NEXT_PUBLIC_DASHBOARD_HOSTNAMES=admin.paridhanemporium.com
